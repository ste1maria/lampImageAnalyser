{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/debug/LampAnalyser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/linux/debug",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/pylon/lib:/usr/lib/x86_64-linux-gnu:/lib:/usr/lib"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "xcb"
                },
                {
                    "name": "PATH",
                    "value": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:/snap/bin"
                }
            ],
            "externalConsole": true,
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                },
                {
                    "description": "Print LD_LIBRARY_PATH",
                    "text": "echo $LD_LIBRARY_PATH",
                    "ignoreFailures": false
                }
            ],
            "logging": {
                "engineLogging": true,
                "trace": false,
                "traceResponse": false
            },
            "preLaunchTask": "Log Environment Variables"  // Add this line
        },
        {
            "name": "Launch Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/release/LampAnalyser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/linux/release",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/pylon/lib:/usr/lib/x86_64-linux-gnu:/lib:/usr/lib"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "xcb"
                },
                {
                    "name": "PATH",
                    "value": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:/snap/bin"
                }
            ],
            "externalConsole": true,
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                },
                {
                    "description": "Print LD_LIBRARY_PATH",
                    "text": "echo $LD_LIBRARY_PATH",
                    "ignoreFailures": false
                }
            ],
            "logging": {
                "engineLogging": true,
                "trace": false,
                "traceResponse": false
            },
            "preLaunchTask": "Log Environment Variables"  // Add this line
        },
 {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows/release/LampAnalyser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {"name": "QT_OPENGL", "value" : "software"},
                {"name" : "QT_DEBUG_PLUGINS", "value" : "1"}
            ]
        },
    ]
}
